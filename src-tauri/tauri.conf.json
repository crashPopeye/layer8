{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "layer8",
  "version": "0.0.0",
  "identifier": "dev.layer8.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "layer8",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#120a10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/layer8d"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQjc2NENFOTQ0MzJFODgKUldTSUxrT1V6bVMzSTZxclhiMG1ROWhqUDExeDJkS1lnRENuNmI0aGFNaGhhTUFwU0NzekRhdXYK",
      "endpoints": ["http://127.0.0.1:7878/api/update/manifest"],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
